# SKV MCP route, included by nginx-proxy into the skv.network server block (survives docker-gen regeneration)
location = /mcp { proxy_pass http://__GW__:8765/; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key; proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection ""; proxy_buffering off; proxy_cache off; proxy_read_timeout 3600s; proxy_send_timeout 3600s;
        proxy_connect_timeout 3s; error_page 502 = @skv_hold_mcp; }
location ^~ /mcp/ { access_log off; proxy_pass http://__GW__:8765/; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key; proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection ""; proxy_buffering off; proxy_cache off; proxy_read_timeout 3600s; proxy_send_timeout 3600s;
        proxy_connect_timeout 3s; error_page 502 = @skv_hold_mcp; }

# gzip for API/MCP JSON (responses over ~16 KB stall on some client egress paths)
gzip on; gzip_proxied any; gzip_min_length 1024; gzip_comp_level 5; gzip_vary on;

# Restart hold (skv-hold.service on the gateway IP, not public): when the API/MCP upstream refuses a request
# (502 = connect refused/closed, i.e. a restart), re-send it to the hold proxy, which waits until the backend
# is up again (<=90 s) and passes it through. Only 502: a 504 (slow request) is never re-sent.
proxy_connect_timeout 3s;
error_page 502 = @skv_hold;
location @skv_hold { proxy_pass http://__GW__:8790; proxy_http_version 1.1; proxy_set_header Connection ""; proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s; }
location @skv_hold_mcp { rewrite ^/mcp/?(.*)$ /$1 break; proxy_pass http://__GW__:8791; proxy_http_version 1.1; proxy_set_header Connection ""; proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off; proxy_read_timeout 3600s; }
