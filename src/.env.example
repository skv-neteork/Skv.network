SKV_API_KEYS=
LLM_API_KEY=
SKV_DOWNLOADS_DIR=/app/downloads
SKV_MEMORY_DIR=/app/app/runtime/memory
SKV_MASTER_DB=/data/skv/metadata_store/shared_master.db
