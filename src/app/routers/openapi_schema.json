{
  "openapi": "3.1.0",
  "info": {
    "title": "SKV Memory Tools",
    "version": "8.2"
  },
  "servers": [
    {
      "url": "https://skv.network"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v7/memory": {
      "post": {
        "operationId": "searchMemory",
        "summary": "\u041f\u043e\u0438\u0441\u043a \u0432 \u043f\u0430\u043c\u044f\u0442\u0438 SKV",
        "description": "\u041e\u0411\u042f\u0417\u0410\u0422\u0415\u041b\u042c\u041d\u041e \u043f\u0435\u0440\u0435\u0434 \u043a\u0430\u0436\u0434\u044b\u043c \u043e\u0442\u0432\u0435\u0442\u043e\u043c.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query_text": {
                    "type": "string",
                    "description": "\u0417\u0430\u043f\u0440\u043e\u0441"
                  },
                  "focus_words": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0441\u043b\u043e\u0432\u0430"
                  }
                },
                "required": [
                  "query_text"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v7/experience/create": {
      "post": {
        "operationId": "saveExperienceCube",
        "summary": "\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043a\u0443\u0431 \u043e\u043f\u044b\u0442\u0430",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "essence": {
                    "type": "string"
                  },
                  "rules_markdown": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "essence",
                  "rules_markdown",
                  "evidence"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v7/experience/vote": {
      "post": {
        "operationId": "submitFeedback",
        "summary": "\u041e\u0446\u0435\u043d\u0438\u0442\u044c \u043a\u0443\u0431",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cube_id": {
                    "type": "string"
                  },
                  "vote": {
                    "type": "integer"
                  }
                },
                "required": [
                  "cube_id",
                  "vote"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "SKV API \u043a\u043b\u044e\u0447. \u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c: https://skv.network/profile"
      }
    }
  }
}