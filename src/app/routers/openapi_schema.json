{
  "openapi": "3.1.0",
  "info": {
    "title": "SKV Network API v8.3",
    "version": "8.3",
    "description": "SKV — коллективная память и инструменты для AI-агентов. Поиск, сохранение, генерация файлов."
  },
  "servers": [{"url": "https://skv.network"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/v7/memory": {
      "post": {
        "operationId": "searchMemory",
        "summary": "Поиск в памяти SKV",
        "description": "ОБЯЗАТЕЛЬНО перед каждым ответом. Гибридный HNSW+FTS5 поиск.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query_text": {"type": "string", "description": "Поисковый запрос"},
                  "focus_words": {"type": "array", "items": {"type": "string"}, "description": "Точные слова для FTS5"},
                  "user_id": {"type": "string", "description": "ID пользователя"},
                  "top_k": {"type": "integer", "default": 5}
                },
                "required": ["query_text", "user_id"]
              }
            }
          }
        }
      }
    },
    "/api/v7/agent/chat": {
      "post": {
        "operationId": "chatWithAgent",
        "summary": "Чат с SKV агентом",
        "description": "Отправь сообщение — агент ответит с SEAL, используя память и конституцию.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {"type": "string"},
                  "message": {"type": "string"},
                  "session_id": {"type": "string", "default": "default"},
                  "step": {"type": "integer", "default": 0},
                  "last_seal": {"type": "string"},
                  "chat_history": {"type": "array", "items": {"type": "object"}}
                },
                "required": ["user_id", "message"]
              }
            }
          }
        }
      }
    },
    "/api/v7/tools/create-file": {
      "post": {
        "operationId": "createFile",
        "summary": "Создать файл",
        "description": "Создаёт файл на сервере. Поддерживает: html, txt, json, csv, md, svg, pdf, png, zip, py, css, js.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filename": {"type": "string", "description": "Имя файла без расширения"},
                  "content": {"type": "string", "description": "Содержимое файла (для PDF/PNG — base64)"},
                  "type": {"type": "string", "enum": ["html", "txt", "json", "csv", "md", "svg", "pdf", "png", "zip", "py", "css", "js"]}
                },
                "required": ["filename", "content", "type"]
              }
            }
          }
        }
      }
    },
    "/api/v7/experience/create": {
      "post": {
        "operationId": "saveExperienceCube",
        "summary": "Сохранить куб опыта",
        "description": "Создаёт новый куб опыта в памяти SKV.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {"type": "string"},
                  "essence": {"type": "string"},
                  "rules_markdown": {"type": "string"},
                  "evidence": {"type": "string"},
                  "session_id": {"type": "string"}
                },
                "required": ["topic", "essence", "rules_markdown", "evidence"]
              }
            }
          }
        }
      }
    },
    "/api/v7/experience/vote": {
      "post": {
        "operationId": "voteOnCube",
        "summary": "Оценить куб",
        "description": "Голосование за куб опыта (1 — полезно, -1 — нерелевантно).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cube_id": {"type": "string"},
                  "user_id": {"type": "string"},
                  "vote": {"type": "integer", "enum": [1, -1]}
                },
                "required": ["cube_id", "user_id", "vote"]
              }
            }
          }
        }
      }
    },
    "/api/v7/event/write": {
      "post": {
        "operationId": "saveEvent",
        "summary": "Сохранить событие",
        "description": "Сохраняет диалог/событие в память пользователя.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {"type": "string"},
                  "session_id": {"type": "string"},
                  "query": {"type": "string"},
                  "response": {"type": "string"},
                  "topic": {"type": "string"}
                },
                "required": ["user_id", "query", "response"]
              }
            }
          }
        }
      }
    },
    "/api/v7/memory/summarize": {
      "post": {
        "operationId": "saveL1Summary",
        "summary": "Сохранить L1 саммари",
        "description": "Краткое содержание последних 15 сообщений.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {"type": "string"},
                  "session_id": {"type": "string"},
                  "topic": {"type": "string"},
                  "summary_text": {"type": "string"},
                  "message_count": {"type": "integer"}
                },
                "required": ["user_id", "session_id", "summary_text"]
              }
            }
          }
        }
      }
    },
    "/api/v7/memory/map": {
      "post": {
        "operationId": "updateL2Map",
        "summary": "Обновить L2 карту памяти",
        "description": "Обновляет профиль пользователя каждые 30 сообщений.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {"type": "string"},
                  "session_count": {"type": "integer"}
                },
                "required": ["user_id"]
              }
            }
          }
        }
      }
    },
    "/api/v7/feedback": {
      "post": {
        "operationId": "submitAnomaly",
        "summary": "Сообщить об ошибке",
        "description": "Отправить репорт об аномалии, баге или предложении.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {"type": "string", "enum": ["anomaly", "bug", "cube_issue", "improvement", "security"]},
                  "title": {"type": "string"},
                  "description": {"type": "string"},
                  "severity": {"type": "integer", "minimum": 1, "maximum": 4}
                },
                "required": ["type", "title", "description"]
              }
            }
          }
        }
      }
    },
    "/api/execute/code": {
      "post": {
        "operationId": "runSandbox",
        "summary": "Выполнить код в песочнице",
        "description": "Python-песочница с авто-фиксом через 3 AI модели.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {"type": "string", "description": "Python код"},
                  "mode": {"type": "string", "enum": ["fix", "optimize", "all"], "default": "fix"},
                  "language": {"type": "string", "default": "python"}
                },
                "required": ["code"]
              }
            }
          }
        }
      }
    },
    "/api/v7/agent/prompt": {
      "get": {
        "operationId": "getAgentPrompt",
        "summary": "Получить системный промпт",
        "description": "Возвращает инструкцию для агента (конституция, SEAL, протокол).",
        "parameters": [
          {"name": "user_id", "in": "query", "required": true, "schema": {"type": "string"}}
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "SKV API ключ. Получить: https://skv.network/profile"
      }
    }
  }
}
