{
  "openapi": "3.0.0",
  "info": {
    "title": "SKV Network API v8.3",
    "version": "8.3",
    "description": "SKV PROTOCOL (same core as MCP): memory_bootstrap → memory_consult → draft → second_look → SEAL → memory_remember → cube_create|cube_nothing → cube_vote|vote_nothing. MCP primary: https://skv.network/mcp + Bearer sk_ from /profile. Without MCP: paste this OpenAPI into agent Actions, or download Guard 2 (GET /api/v7/agent/guardian.py) for local draft insurance. Guard 1 only reminds missed steps in /memory responses."
  },
  "paths": {
    "/api/v7/memory": {
      "post": {
        "operationId": "memory_consult",
        "summary": "memory_consult — search memory before answering (PROTOCOL step A).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query_text": {
                    "type": "string"
                  },
                  "top_k": {
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "query_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "fragments, previous, memory_map, shared_cubes, duty_error"
          }
        },
        "description": "PROTOCOL: call before every answer. Rewrite user sentence to English search query (keep names/rare terms). Empty → say no match; do not invent. After ~3 misses use memory_dig. Session start: prefer memory_bootstrap (POST /session/bootstrap) or GET /memory/start."
      }
    },
    "/api/v7/remember": {
      "post": {
        "operationId": "memory_remember",
        "summary": "memory_remember — save turn immediately after answer (PROTOCOL step F).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "response": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "pin": {
                    "type": "boolean"
                  },
                  "critical": {
                    "type": "string"
                  },
                  "l1_summary": {
                    "type": "string"
                  },
                  "l2_map": {
                    "type": "string"
                  },
                  "cube_topic": {
                    "type": "string"
                  },
                  "cube_rules": {
                    "type": "string"
                  },
                  "cube_evidence": {
                    "type": "string"
                  },
                  "duty": {
                    "type": "string"
                  },
                  "duty_reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "saved"
          }
        }
      }
    },
    "/api/v7/memory/dig": {
      "post": {
        "operationId": "memory_dig",
        "summary": "After three misses, ask the server to scan stored text. If not_found, say you do not know.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "user_id",
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "found or not_found"
          }
        }
      }
    },
    "/api/v7/event/{event_id}": {
      "get": {
        "operationId": "memory_event",
        "summary": "Open an earlier repeat from previous. Do not search again.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "full event"
          }
        }
      }
    },
    "/api/v7/experience/vote": {
      "post": {
        "operationId": "cube_vote",
        "summary": "cube_vote — rate a cube, or use memory_remember(duty=vote_nothing).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "cube_id": {
                    "type": "string"
                  },
                  "vote": {
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "cube_id",
                  "vote"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "rating"
          }
        }
      }
    },
    "/api/v7/agent/guardian.py": {
      "get": {
        "operationId": "download_guard2",
        "summary": "Download Guard 2 v3 (skv-guardian2.py). It holds an answer without service lines, save, Second Look or seal.",
        "responses": {
          "200": {
            "description": "python sdk"
          }
        }
      }
    },
    "/api/v7/memory/forget/preview": {
      "post": {
        "operationId": "memory_forget_preview",
        "summary": "Step 1 of deleting memory. Returns matched items, a one-time token and purge_at. Show the items to the user and tell them: 'These records will be removed from memory now. You can restore them within 30 days; after that they are deleted permanently.' Get an explicit yes. Never auto-confirm.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "text",
                      "topic",
                      "event"
                    ]
                  },
                  "event_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview, nothing deleted"
          }
        }
      }
    },
    "/api/v7/memory/forget/confirm": {
      "post": {
        "operationId": "memory_forget_confirm",
        "summary": "Step 2. Call only after the user explicitly said yes to the preview. Send the preview token and user_confirmed=true. Single use, 5 minute TTL. Returns archived_at and purge_at (30 days).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "user_confirmed"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "user_confirmed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Removed from memory; restorable until purge_at, then deleted permanently"
          },
          "428": {
            "description": "user_confirmed missing"
          },
          "409": {
            "description": "Token used"
          },
          "410": {
            "description": "Token expired"
          }
        }
      }
    },
    "/api/v7/memory/forget/restore": {
      "post": {
        "operationId": "memory_forget_restore",
        "summary": "Undo a confirmed forget within 30 days, using the same token. After purge_at the records are gone permanently.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Restored (count 0 if the window passed)"
          }
        }
      }
    },
    "/api/v7/agent/turn": {
      "get": {
        "operationId": "agentTurnGet",
        "summary": "MAIN PATH: one call per user message. Searches memory, saves the turn, checks [ev:id], returns verdict + seal. Seal = steps done + sources real, not proof of truth.",
        "parameters": [
          {
            "name": "k",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "sk_ key"
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "user message"
          },
          {
            "name": "draft",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "your draft answer"
          }
        ],
        "responses": {
          "200": {
            "description": "verdict, seal, event_id"
          }
        }
      }
    },
    "/api/v7/agent/feedback": {
      "get": {
        "operationId": "agentFeedback",
        "summary": "Report a bug/idea about SKV (GET-only friendly). Max 10/hour per key; secrets masked.",
        "parameters": [
          {
            "name": "k",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "sk_ key"
          },
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "what happened"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "bug|idea|praise"
          }
        ],
        "responses": {
          "200": {
            "description": "feedback_id"
          }
        }
      }
    }
  }
}