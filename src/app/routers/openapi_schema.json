{
  "openapi": "3.0.0",
  "info": {
    "title": "SKV Network API v8.3",
    "version": "8.3",
    "description": "New chat paste: work through SKV. First call POST /api/v7/memory with step 0 to load the map and constitution. Later, search when the past can change the answer. After every reply POST /api/v7/remember. Header Authorization Bearer sk_key. Tools: searchMemory, remember, digMemory, openEvent, voteCube. Guardian: GET /api/v7/agent/guardian.py"
  },
  "paths": {
    "/api/v7/memory": {
      "post": {
        "operationId": "searchMemory",
        "summary": "Read memory. Rewrite the user sentence first: names and rare words in, common words out.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query_text": {
                    "type": "string"
                  },
                  "top_k": {
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "query_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "fragments, previous, memory_map, shared_cubes, duty_error"
          }
        }
      }
    },
    "/api/v7/remember": {
      "post": {
        "operationId": "remember",
        "summary": "Write a turn, a >>> mark, L1, L2, a shared cube, or duty=cube_nothing / vote_nothing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "response": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "pin": {
                    "type": "boolean"
                  },
                  "critical": {
                    "type": "string"
                  },
                  "l1_summary": {
                    "type": "string"
                  },
                  "l2_map": {
                    "type": "string"
                  },
                  "cube_topic": {
                    "type": "string"
                  },
                  "cube_rules": {
                    "type": "string"
                  },
                  "cube_evidence": {
                    "type": "string"
                  },
                  "duty": {
                    "type": "string"
                  },
                  "duty_reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "saved"
          }
        }
      }
    },
    "/api/v7/memory/dig": {
      "post": {
        "operationId": "digMemory",
        "summary": "After three misses, ask the server to scan stored text. If not_found, say you do not know.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "user_id",
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "found or not_found"
          }
        }
      }
    },
    "/api/v7/event/{event_id}": {
      "get": {
        "operationId": "openEvent",
        "summary": "Open an earlier repeat from previous. Do not search again.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "full event"
          }
        }
      }
    },
    "/api/v7/experience/vote": {
      "post": {
        "operationId": "voteCube",
        "summary": "Vote on a shared experience cube you used. +1 or -1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "cube_id": {
                    "type": "string"
                  },
                  "vote": {
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "cube_id",
                  "vote"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "rating"
          }
        }
      }
    },
    "/api/v7/agent/guardian.py": {
      "get": {
        "operationId": "downloadGuardian",
        "summary": "Download the local guardian. It hides an answer that has no SKV seal.",
        "responses": {
          "200": {
            "description": "python sdk"
          }
        }
      }
    }
  }
}